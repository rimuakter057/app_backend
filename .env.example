PROJECT_NAME=Real Estate API
DEBUG=True

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/real_estate

JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_MINUTES=10080

# "*" is invalid alongside allow_credentials=True (browsers reject it) — list real origins instead
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
